<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>FoundersCIV_M05_Observer</AssemblyName>
    <OutputType>Library</OutputType>
    <!-- M05.3: always build against LOCAL COPIES of the installed game's dependencies.
         build_bridge.ps1 stages these files; no $(GameDir) substitution is required. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="FoundersCIV_M05_Observer.cs" />
    <Reference Include="BepInEx"><HintPath>../build/refs/BepInEx.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>../build/refs/0Harmony.dll</HintPath><Private>False</Private></Reference>
    <!-- UnityEngine.dll defines the MonoBehaviour base class for BepInEx 5.
         CoreModule and IMGUI are ALSO required for Time, JsonUtility, GUI, etc. -->
    <Reference Include="UnityEngine"><HintPath>../build/refs/UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>../build/refs/UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>../build/refs/UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <!-- UnityEngine.JsonUtility is defined in JSONSerializeModule, not CoreModule. -->
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>../build/refs/UnityEngine.JSONSerializeModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
